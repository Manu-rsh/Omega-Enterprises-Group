{% assign whatsappNumber = "919873468015" %}
{% assign defaultMessage = "Hi, Omega Perfumes India.%0A%0AI would like to inquire about perfume.%0A%0ACould you please provide more details?" %}
{% assign buttonPosition = "right" %}
{% assign buttonColor = "#25d366" %}
{% assign marginBottom = "3.50em" %}
{% assign marginLeft = "1em" %}
{% assign marginRight = "1.25em" %}
{% assign zIndex = "9999" %}
{% assign showCloseButton = false %}

{%- comment -%}
✅ Auto-include product name + URL if on product page
{%- endcomment -%}
{% if template contains 'product' %}
  {% assign Message = 
    "Hi, Omega Perfumes India.%0A%0A" 
    | append: "I would like to inquire about this product:%0A%0A" 
    | append: product.title 
    | append: "%0A%0A" 
    | append: shop.url 
    | append: product.url 
    | append: "%0A%0A" 
    | append: "Could you please provide more details?" 
  %}
{% else %}
  {% assign Message = defaultMessage %}
{% endif %}

{% if buttonPosition == "left" %}
  {% assign positionStyle = "left: " | append: marginLeft %}
{% else %}
  {% assign positionStyle = "right: " | append: marginRight %}
{% endif %}

<style>
  .whatsapp-button-container {
    position: fixed;
    bottom: {{ marginBottom }};
    {{ positionStyle }};
    z-index: {{ zIndex }};
    cursor: pointer;
  }

  .whatsapp-button {
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: {{ buttonColor }};
    color: #fff;
    border-radius: 50%;
    width: 2.9em;
    height: 2.9em;
    box-shadow: 0 4px 8px rgba(0,0,0,0.25);
    position: relative;
    animation: pulse 2s infinite ease-in-out;
    overflow: hidden;
    padding: 0.2em; /* 🔹 smaller border space */
  }

  .whatsapp-button img {
    height: 2.0em;  /* 🔹 slightly bigger logo */
    width: 2.0em;
  }

  .whatsapp-button::after {
    content: "";
    position: absolute;
    top: 0;
    left: -100%;
    width: 70%;
    height: 100%;
    background: linear-gradient(
      120deg,
      rgba(255, 255, 255, 0.7) 0%,
      rgba(255, 255, 255, 0.3) 30%,
      rgba(255, 255, 255, 0) 100%
    );
    transform: skewX(-20deg);
    animation: shine 1.5s infinite;
  }

  @keyframes pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.12); }
  }

  @keyframes shine {
    0% { left: -100%; opacity: 0.2; }
    20% { opacity: 1; }
    50% { left: 120%; opacity: 1; }
    100% { left: 120%; opacity: 0; }
  }

  /* Popup message style */
  .whatsapp-popup {
    position: absolute;
    bottom: 110%;
    right: 0;
    background-color: #fff;
    color: #111;
    padding: 8px 12px;
    border-radius: 8px;
    font-size: 0.9em;
    white-space: nowrap;
    box-shadow: 0 2px 6px rgba(0,0,0,0.2);
    opacity: 0;
    transform: translateY(10px);
    transition: all 0.3s ease;
    pointer-events: none;
  }

  .whatsapp-popup.show {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .close-button {
    position: absolute;
    top: -0.5em;
    right: -0.5em;
    background-color: black;
    color: white;
    width: 1.25em;
    height: 1.25em;
    border-radius: 50%;
    text-align: center;
    line-height: 1.25em;
    font-weight: bold;
    cursor: pointer;
    display: {% if showCloseButton %}block{% else %}none{% endif %};
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const button = document.querySelector('.whatsapp-button');
    const popup = document.querySelector('.whatsapp-popup');
    let firstClick = true;

    button.addEventListener('click', function(e) {
      e.preventDefault();
      if (firstClick) {
        popup.classList.add('show');
        setTimeout(() => popup.classList.remove('show'), 3000); // auto-hide after 3s
        firstClick = false;
      } else {
        window.open("https://api.whatsapp.com/send?phone={{ whatsappNumber }}&text={{ Message }}", "_blank");
      }
    });

    const closeBtn = document.querySelector('.close-button');
    if (closeBtn) {
      closeBtn.addEventListener('click', function() {
        document.querySelector('.whatsapp-button-container').style.display = 'none';
      });
    }
  });
</script>

<div class="whatsapp-button-container">
  <div class="whatsapp-popup">💬 Chat with us on WhatsApp</div>

  <a
    class="whatsapp-button"
    href="#"
    aria-label="Chat on WhatsApp"
  >
    <img
      src="https://cdn.shopify.com/s/files/1/0921/2051/4924/files/Whatsapp_Logo.png?v=1751782174"
      alt="WhatsApp"
    />
  </a>

  {% if showCloseButton %}
    <div class="close-button">×</div>
  {% endif %}
</div>
